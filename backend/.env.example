# Copy to backend/.env and fill in. backend/.env is gitignored.
# Variable names are unchanged from the Node server; the one value that differs
# is DATABASE_URL, which now names a SQLite file instead of a PostgreSQL server.

NODE_ENV=development
PORT=4000

# SQLite database file. A relative path resolves against backend/; use four
# slashes for an absolute path (sqlite:////var/data/reanmate.db). The file and
# its folder are created on first use; run `python -m scripts.migrate` to build
# the schema. On a host with an ephemeral filesystem, point this at a
# persistent disk or every deploy starts from an empty database.
DATABASE_URL=sqlite:///instance/reanmate.db

# Vite dev server origin. Comma-separate to add more.
# Must be exact — cookies forbid a wildcard origin.
CORS_ORIGINS=http://localhost:5173

JSON_BODY_LIMIT=1mb

# Change this. Any value works in dev; a leaked secret forges sessions in prod.
# Keep the same value as the old Node server and existing sessions stay valid.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Local disk storage. A relative path resolves against backend/. To keep files
# uploaded under the Node server, point this at them: UPLOAD_DIR=../server/uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400

OTP_TTL_MINUTES=10

# Leave unset until a key exists — the AI layer falls back to the mock provider
# and logs one warning at boot.
# OPENAI_API_KEY=
# Any OpenAI-compatible endpoint. Leave unset to use api.openai.com.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
OPENAI_MODEL=gpt-5.6-luna
# 1536 dims, matching document_chunks.embedding vector(1536). Changing this
# model means a migration and a full re-embed.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- AI speed ------------------------------------------------------------------
# AI requests one generation may run at once (study-guide modules, summary
# chapters, mock-exam parts). Lower it if the provider returns rate-limit errors.
AI_MAX_CONCURRENCY=8
# Background jobs (ingest, on-demand generations) that run side by side.
JOB_WORKERS=4
# true = background generations use OpenAI's "flex" tier: cheaper, ~2x slower.
OPENAI_USE_FLEX=false

# Leave unset until an SMS/email provider is chosen — the notify layer falls
# back to the mock, which prints OTP codes and keeps an in-memory outbox.
# SMS_PROVIDER=
# EMAIL_PROVIDER=
