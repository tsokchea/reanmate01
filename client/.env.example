# Copy to client/.env to override. client/.env is gitignored.
# The shipped default is the live API. Enable only for backend-free UI review.
# Changing this build-time value requires a Vite restart.
VITE_DEMO=false

# Where the Flask API lives. Leave unset to use same-origin /api — the Vite
# dev proxy below in development, the Vercel rewrite in production. Set it to
# call the API directly (its CORS_ORIGINS must then include this app's origin):
# VITE_API_URL=http://localhost:4000/api

# Dev-proxy target for /api when VITE_API_URL is unset (default http://localhost:4000).
# API_PROXY_TARGET=http://localhost:5000
