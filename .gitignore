# dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# build output
client/dist/
client/.vite/

# environment / secrets
.env
.env.*
*.env
!.env.example

server/.env
server/.env.*
!server/.env.example

backend/.env
backend/.env.*
!backend/.env.example

client/.env
client/.env.*
!client/.env.example

# demo mode is local-only and must never be used in a hosted build
client/.env.demo

# certs / keys
*.pem
*.key
*.crt
*.p12

# uploads (multer local disk in dev; replace with S3/object storage before hosting)
server/uploads/
server/storage/
backend/uploads/
backend/storage/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# never allow non-npm lockfiles (CLAUDE.md hard rule)
pnpm-lock.yaml
yarn.lock
bun.lockb

# local SQLite database (backend/instance/reanmate.db and its WAL files)
backend/instance/
*.db-wal
*.db-shm
